# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors and operating systems
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Restricted challenge data (keep only the public-facing description)
/data/*
!/data/README.md

# Downloaded model weights and generated training outputs
/checkpoints/
/artifacts/
/logs/

# Generated qualitative reports (keep Markdown summaries)
/reports/*
!/reports/*.md

# Common ML experiment trackers
/wandb/
/mlruns/
/lightning_logs/
/runs/

# Temporary files
*.tmp
*.temp
*.log
